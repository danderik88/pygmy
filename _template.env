# BFF credentials template. Copy to secrets/printers.env (mode 600) and fill in. Never commit real values.
# One block per printer: BFF_<ALIAS>_*
BFF_A1_IP=
BFF_A1_SERIAL=
BFF_A1_ACCESS_CODE=

BFF_PILOT_URL=
BFF_PILOT_ADMIN_USER=
BFF_PILOT_ADMIN_PASSWORD=

# go2rtc: RTSP credentials handed to clients by camera_urls, and the host name used in the RTSP URL.
BFF_RTSP_USER=
BFF_RTSP_PASS=
BFF_PUBLIC_HOST=

# Home Assistant: Pygmy publishes every printer over MQTT (discovery under `homeassistant`) when these four are set.
# BFF_HA_MQTT_HOST=
# BFF_HA_MQTT_PORT=1883
# BFF_HA_MQTT_USER=
# BFF_HA_MQTT_PASSWORD=

# Used by scripts/backup-pull.sh and restore.sh. Copy to secrets/backup.env.
BFF_PROXMOX_HOST=
